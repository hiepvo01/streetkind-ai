rules_version = '2';

// All uploads/deletes go through the backend using the Admin SDK, which
// bypasses these rules. Audio files under audio/** are made public at the
// blob level, so playback works via direct URL regardless of this rule.
service firebase.storage {
    match /b/{bucket}/o {
        match /{allPaths=**} {
            allow read: if false;
            allow write: if false;
        }
    }
}

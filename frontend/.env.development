# CRA reads this only when running `npm start`. Production builds
# (`npm run build`) ignore it - those env vars are set by the deploy
# command. See DEPLOYMENT.md for the prod build command.
#
# Audio capture defaults ON in local dev so the recording preview
# player and the upload-on-submit path are exercised. Pair this with
# AUDIO_LOCAL_DIR=./local_audio_storage on the backend so files stay
# on your machine instead of going to the shared Firebase bucket.
REACT_APP_ENABLE_AUDIO=1

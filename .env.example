# =============================================================================
# StreetKind AI - backend environment
# Copy to .env and fill in. Backend reads via load_dotenv() in app/__init__.py.
# Required vars at top, optional vars at bottom.
# =============================================================================


# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Microsoft Foundry (Anthropic-hosted-on-Azure). Used by AI extraction and the
# "Magic generate" narrative button. Get values from your Azure AI Foundry
# resource page.
ANTHROPIC_FOUNDRY_API_KEY=
# Use ONE of the next two (full URL or resource name; the SDK builds the URL
# from the resource name):
ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic/
# ANTHROPIC_FOUNDRY_RESOURCE=your-resource

# Firebase service account JSON (Admin SDK). Used for RTDB writes, ID token
# verification, and Storage signing. Generate at:
#   Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Firebase Storage bucket. Required for audio recording to work in production.
# Without this set, /api/forms/incident/{id}/transcripts/{tid}/audio returns
# 503 and audio is dropped (text transcripts still saved). Get the bucket
# name from Firebase Console → Storage. Format is "<project-id>.firebasestorage.app".
# Project must be on the Blaze plan to use Storage.
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# CORS origins for the API (comma-separated, no spaces). Required so the
# Firebase Hosting frontend can call this backend. Add your prod hostname.
CORS_ORIGINS=http://localhost:3000,https://your-project.web.app


# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# OpenAI Whisper transcription. When set, the frontend sends each recorded
# audio blob to /api/transcribe for a high-accuracy transcript that replaces
# the Web Speech API live text. Without this, the browser's live text is used
# as-is. Sign up at https://platform.openai.com/api-keys; expect ~$0.006/min.
# OPENAI_API_KEY=sk-proj-...
# Override the Whisper model (defaults to whisper-1). gpt-4o-transcribe is
# slightly newer and similar pricing.
# WHISPER_MODEL=whisper-1

# Local-disk audio storage (DEV ONLY). When set, audio uploads write to this
# directory instead of Firebase Storage. Files are served at
# /local-audio/audio/<incident>/<transcript>.webm via FastAPI's StaticFiles
# mount so playback works without signing. DO NOT set in production - it
# bypasses the signed-URL privacy model.
# AUDIO_LOCAL_DIR=./local_audio_storage

# AI model override (defaults to config/app.json `ai.default_model`,
# currently "claude-sonnet-4-6"). Use the deployment name your Foundry
# endpoint expects.
# AI_MODEL=claude-sonnet-4-6

# Max audio blob size in bytes (default 20MB).
# MAX_AUDIO_BYTES=20971520

# Max transcript length in characters (default 5000).
# MAX_TRANSCRIPT_LENGTH=5000

# Signed URL TTL for Firebase Storage audio playback URLs (default 3600 / 1h).
# AUDIO_SIGNED_URL_TTL_SECONDS=3600

# Cache TTL in seconds for the users-tree fetch used by hierarchy access
# checks. Default 30. Set 0 to disable.
# USERS_CACHE_TTL_SECONDS=30

# Microsoft Foundry (Claude) — API key from Azure AI Foundry / deployment
ANTHROPIC_FOUNDRY_API_KEY=

# Endpoint: use ONE of the following (not both).
# Full base URL from Foundry (often ends with /anthropic/):
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic/
# Or resource name only (SDK builds the URL above):
# ANTHROPIC_FOUNDRY_RESOURCE=your-resource

# Firebase (service account required for RTDB writes and token verification on protected routes)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Firebase Storage bucket for voice transcript AUDIO (optional).
# Leaving this unset means text transcripts are still stored in RTDB but no
# audio blob is saved - /api/.../audio returns 503. To enable audio storage:
#   1. Upgrade the Firebase project to Blaze (pay-as-you-go)
#   2. Init Storage in the Firebase Console
#   3. Set FIREBASE_STORAGE_BUCKET here AND rebuild the frontend with
#      REACT_APP_ENABLE_AUDIO=1
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Max audio blob size in bytes (optional, default 20MB)
# MAX_AUDIO_BYTES=20971520

# AI model override (optional - defaults to config/app.json value).
# Use the deployment name your Foundry endpoint expects.
# AI_MODEL=claude-haiku-4-5-20251001

# Whisper model override (optional - defaults to config/app.json value)
# WHISPER_MODEL=base

# CORS origins (comma-separated, defaults to localhost:3000)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Max transcript length in characters (optional, default 5000)
# MAX_TRANSCRIPT_LENGTH=5000

# Cache TTL for downloading the full users tree (optional, default 30).
# Set to 0 to disable caching.
# USERS_CACHE_TTL_SECONDS=30
